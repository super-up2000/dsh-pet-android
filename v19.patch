+package com.dshpet.android
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.util.concurrent.Executors
+
+/**
+ * 天气（v1.9，opt-in 联网）：用 Open-Meteo（**免 API key**）取用户指定城市的当前天气。
+ *
+ * 设计原则：设置页关着（默认）就**完全不调用**本类，App 保持「默认零网络」的既有设计；
+ * 只有用户主动打开「天气」并填了城市名，才走这里的两段请求：
+ *   1) 地理编码：城市名 → 经纬度（geocoding-api.open-meteo.com）
+ *   2) 当前天气：经纬度 → 温度 + 天气码（api.open-meteo.com/v1/forecast?current=...）
+ *
+ * 结果写 `files/weather.json`（带时间戳）做 30 分钟缓存，重启 / 重新触发直接读缓存不联网。
+ * 任何一步失败都静默降级（Diag 记一笔，返回 null），绝不影响桌宠其它功能。
+ */
+object Weather {
+
+    data class Report(val temp: Int, val code: Int, val desc: String, val fromCache: Boolean)
+
+    private const val CACHE_MAX_AGE_MS = 30 * 60 * 1000L
+    private const val CONNECT_TIMEOUT_MS = 6000
+    private const val READ_TIMEOUT_MS = 10000
+
+    /** 单线程执行器：后台发请求，不占主线程 */
+    private val io = Executors.newSingleThreadExecutor()
+    private val main = Handler(Looper.getMainLooper())
+
+    /** 防止同一时刻重复请求（点得很快时） */
+    @Volatile
+    private var inFlight = false
+
+    private fun cacheFile(ctx: Context): File =
+        File(ctx.getExternalFilesDir(null) ?: ctx.filesDir, "weather.json")
+
+    /**
+     * 取城市当前天气。`onResult` 一定在主线程回调：
+     *  - 成功 → [Report]（可能是缓存）
+     *  - 失败 / 没填城市 / 网络不可用 → null
+     */
+    fun fetch(ctx: Context, city: String, onResult: (Report?) -> Unit) {
+        val trimmed = city.trim()
+        if (trimmed.isEmpty()) {
+            onResult(null)
+            return
+        }
+        // 1) 同城市 + 30 分钟内 → 直接用缓存，不联网
+        try {
+            val f = cacheFile(ctx)
+            if (f.isFile) {
+                val obj = JSONObject(f.readText())
+                if (
+                    obj.optString("city") == trimmed &&
+                    SystemClock.elapsedRealtime() - obj.optLong("fetchedAtMs") < CACHE_MAX_AGE_MS
+                ) {
+                    onResult(reportOf(obj, fromCache = true))
+                    return
+                }
+            }
+        } catch (_: Throwable) {
+            // 缓存读不了就重取
+        }
+
+        if (inFlight) return  // 上一次还没回来，不叠加
+        if (!hasNetwork(ctx)) {
+            Diag.record(ctx, "天气：当前无网络，跳过")
+            onResult(null)
+            return
+        }
+        inFlight = true
+        io.execute {
+            var report: Report? = null
+            try {
+                report = doFetch(trimmed)
+                if (report != null) save(ctx, trimmed, report)
+            } catch (t: Throwable) {
+                Diag.record(ctx, "天气抓取失败（$trimmed）", t)
+            }
+            val result = report
+            inFlight = false
+            main.post { onResult(result) }
+        }
+    }
+
+    private fun doFetch(city: String): Report? {
+        // 1) 地理编码：城市名 → 经纬度（取第一个命中）
+        val geoUrl = "https://geocoding-api.open-meteo.com/v1/search?name=" +
+            URLEncoder.encode(city, "UTF-8") + "&count=1&language=zh"
+        val geo = httpGet(geoUrl) ?: return null
+        val gobj = JSONObject(geo)
+        val results = gobj.optJSONArray("results") ?: return null
+        if (results.length() == 0) return null
+        val first = results.getJSONObject(0)
+        val lat = first.optDouble("latitude", Double.NaN)
+        val lon = first.optDouble("longitude", Double.NaN)
+        if (lat.isNaN() || lon.isNaN()) return null
+
+        // 2) 当前天气：温度 + 天气码
+        val fUrl = "https://api.open-meteo.com/v1/forecast?latitude=$lat&longitude=$lon" +
+            "&current=temperature_2m,weather_code&timezone=auto"
+        val fobj = JSONObject(httpGet(fUrl) ?: return null)
+        val cur = fobj.optJSONObject("current") ?: return null
+        val temp = cur.optInt("temperature_2m", Int.MIN_VALUE)
+        val code = cur.optInt("weather_code", -1)
+        if (temp == Int.MIN_VALUE && code < 0) return null
+        return Report(temp = if (temp == Int.MIN_VALUE) 0 else temp, code = if (code < 0) 3 else code,
+            desc = codeToDesc(code), fromCache = false)
+    }
+
+    private fun save(ctx: Context, city: String, r: Report) {
+        try {
+            val obj = JSONObject()
+            obj.put("city", city)
+            obj.put("fetchedAtMs", SystemClock.elapsedRealtime())
+            obj.put("temp", r.temp)
+            obj.put("code", r.code)
+            val f = cacheFile(ctx)
+            f.parentFile?.mkdirs()
+            f.writeText(obj.toString())
+        } catch (t: Throwable) {
+            Diag.record(ctx, "天气缓存写入失败", t)
+        }
+    }
+
+    private fun reportOf(obj: JSONObject, fromCache: Boolean): Report? {
+        val temp = obj.optInt("temp", Int.MIN_VALUE)
+        val code = obj.optInt("code", -1)
+        if (temp == Int.MIN_VALUE && code < 0) return null
+        return Report(
+            temp = if (temp == Int.MIN_VALUE) 0 else temp,
+            code = if (code < 0) 3 else code,
+            desc = codeToDesc(code),
+            fromCache = fromCache,
+        )
+    }
+
+    private fun hasNetwork(ctx: Context): Boolean = try {
+        val cm = ctx.getSystemService(Context.CONNECTIVITY_SERVICE)
+            ?: return@try false
+        @Suppress("DEPRECATION")
+        cm.activeNetworkInfo?.isConnected ?: false
+    } catch (_: Throwable) {
+        false
+    }
+
+    private fun httpGet(url: String): String? = try {
+        val conn = URL(url).openConnection() as HttpURLConnection
+        conn.connectTimeout = CONNECT_TIMEOUT_MS
+        conn.readTimeout = READ_TIMEOUT_MS
+        conn.requestMethod = "GET"
+        conn.requestProperties["User-Agent"] = "dsh-pet-android/1.9"
+        val code = conn.responseCode
+        if (code !in 200..299) {
+            conn.disconnect()
+            return null
+        }
+        val text = conn.inputStream.bufferedReader().use { it.readText() }
+        conn.disconnect()
+        text
+    } catch (_: Throwable) {
+        null
+    }
+
+    /** WMO weather_code → 一句人话（够冒泡用的精度即可） */
+    fun codeToDesc(code: Int): String = when (code) {
+        0 -> "晴朗"
+        1 -> "大致晴朗"
+        2 -> "多云"
+        3 -> "阴天"
+        45, 48 -> "有雾"
+        51, 53, 55, 56, 57 -> "毛毛雨"
+        61, 63, 65, 66, 67 -> "下雨"
+        71, 73, 75, 77 -> "下雪"
+        80, 81, 82 -> "有阵雨"
+        85, 86 -> "阵雪"
+        95, 96, 99 -> "有雷暴"
+        else -> "天不错"
+    }
+}
