+ * 传感器：把手机姿态变成桌宠的两种操控（对应上游 dsh-pet 的两个物理开关）：
+ *
+ *  - 倾斜控制（`physics.tiltGravity`）：把加速度计的「重力分量」换算成屏幕坐标系的重力向量。
+ *    手机竖直拿着时 ≈ (0, 1400px/s²) 固定向下，和默认重力手感一致；
+ *    转手腕把一侧压低 → 重力横向分量出现，宠物就会往那侧滑（「走开」）。
+ *  - 摇一摇（`physics.shakeThrow`）：检测猛甩（高通分量 > 阈值）→ 回调甩动方向与力度，
+ *    由 Service 把初速打给宠物，走现成的抛体物理（撞边反弹 / 落地摩擦全套都在）。
+ *
+ * 传感器事件默认落在主线程，和帧循环同线程，读写字段无需额外同步（@Volatile 兜底）。
+ * 取不到加速度计的机型（个别模拟器 / 平板）自动降级：available=false，功能静默失效。
+ */
+class Sensors(private val ctx: Context) : SensorEventListener {
+
+    companion object {
+        /** m/s² → px/s²：让 9.81m/s² ≈ 1400px/s²（与 Physics.gravity 默认值对齐） */
+        const val GAIN = 143.0
+        /** 低通滤波系数（0..1，越大越平滑、越跟手慢） */
+        private const val LPF = 0.8f
+        /** 高通分量（m/s²）超过此值算一次甩动 ≈ 1.2g */
+        private const val SHAKE_THRESHOLD = 12.0
+        /** 两连甩的最小间隔（毫秒） */
+        private const val SHAKE_COOLDOWN_MS = 700L
+        /** 甩动力度归一化参考（m/s²） */
+        private const val SHAKE_REF = 15.0
+    }
+
+    /** 屏幕坐标系重力向量（px/s²）：sx 向右、sy 向下。默认 (0,0) = 尚未采样 */
+    @Volatile var sx = 0.0
+    @Volatile var sy = 0.0
+    @Volatile var available = false
+
+    /** 摇一摇回调：方向（已归一化，屏幕系：右/下为正）+ 力度 0..1 */
+    var onShake: ((dirX: Double, dirY: Double, power: Double) -> Unit)? = null
+
+    private val sm: SensorManager? =
+        ctx.getSystemService(Context.SENSOR_SERVICE) as? SensorManager
+    private val sensor: Sensor? = sm?.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
+
+    private var lpX = 0f
+    private var lpY = 0f
+    private var lpZ = 0f
+    private var lastShakeMs = 0L
+
+    /** 注册监听；没有加速度计返回 false（调用方静默降级即可） */
+    fun start(): Boolean {
+        val s = sensor
+        if (sm == null || s == null) {
+            available = false
+            return false
+        }
+        return try {
+            sm.registerListener(this, s, SensorManager.SENSOR_DELAY_GAME)
+            available = true
+        } catch (t: Throwable) {
+            Diag.record(ctx, "注册加速度计失败", t)
+            available = false
+            false
+        }
+    }
+
+    fun stop() {
+        try {
+            sm?.unregisterListener(this)
+        } catch (_: Throwable) {
+        }
+        available = false
+    }
+
+    override fun onSensorChanged(event: SensorEvent) {
+        if (event.sensor.type != Sensor.TYPE_ACCELEROMETER) return
+        val x = event.values[0]
+        val y = event.values[1]
+        val z = event.values[2]
+        // 低通拿重力分量
+        lpX = LPF * lpX + (1 - LPF) * x
+        lpY = LPF * lpY + (1 - LPF) * y
+        lpZ = LPF * lpZ + (1 - LPF) * z
+        // 屏幕系重力：手机竖直 → (0, +9.81*GAIN) 向下；右侧压低 → sx 增大（往右滑）。
+        // 推导：静止时加速度计读 f=-g，即 g_device = -f；屏幕系 = (g_dev_x, -g_dev_y)，
+        // 因为屏幕 y 轴向下、而设备 y 轴向上。
+        sx = -lpX * GAIN
+        sy = +lpY * GAIN
+
+        // 高通拿甩动
+        val hx = x - lpX
+        val hy = y - lpY
+        val hz = z - lpZ
+        val mag = hypot(hx.toDouble(), hy.toDouble(), hz.toDouble())
+        if (mag < SHAKE_THRESHOLD) return
+        val now = System.nanoTime() / 1_000_000
+        if (now - lastShakeMs < SHAKE_COOLDOWN_MS) return
+        lastShakeMs = now
+        val len = mag.coerceAtLeast(1e-6)
+        // 屏幕系方向：x 右为正（设备 x 与屏幕 x 同向，取 +），y 下为正（设备 y 向上，取 -）。
+        // 高通分量 ≈ 手机加速度，所以「甩向右 → 她飞向右」，符合直觉。
+        val dirX = hx / len
+        val dirY = -hy / len
+        val power = (mag / SHAKE_REF).coerceIn(0.0, 1.0)
+        // 方向太近水平线（纯前后甩）时横向分量≈0：保持原样，Service 侧会用 vy 兜底
+        onShake?.invoke(dirX, dirY, power)
+    }
+
+    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {
+        // 精度变化不影响用法
+    }
+}
